#!/bin/sh
# Runs the Gradle wrapper on JDK 25 (RetroFuturaGradle 2 requires it), overriding an org.gradle.java.home
# pinned in ~/.gradle/gradle.properties. Sources are still compiled by the JDK 17 toolchain (Jabel).
# Java ignores HTTP(S)_PROXY, so an environment proxy is forwarded to the JVMs as system properties.
cd "$(dirname "$0")" || exit 1
GRADLE_JDK=${GRADLE_JDK:-/storage/opt/jdk-25}
export JAVA_HOME="$GRADLE_JDK"
if [ -n "$HTTPS_PROXY" ]; then
    P=${HTTPS_PROXY#*://}; P=${P%/}; PH=${P%:*}; PP=${P##*:}
    export JAVA_TOOL_OPTIONS="$JAVA_TOOL_OPTIONS -Dhttps.proxyHost=$PH -Dhttps.proxyPort=$PP -Dhttp.proxyHost=$PH -Dhttp.proxyPort=$PP -Dhttp.nonProxyHosts=localhost|127.0.0.1"
fi
exec ./gradlew -Dorg.gradle.java.home="$GRADLE_JDK" "$@"
